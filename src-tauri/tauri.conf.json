{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CSP 学习助手",
  "version": "1.7.4",
  "identifier": "com.csp.desktop-pet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "CSP 学习助手",
        "width": 950,
        "height": 560,
        "resizable": true,
        "minWidth": 800,
        "minHeight": 500,
        "center": true,
        "decorations": true,
        "visible": false
      },
      {
        "label": "pet",
        "title": "CSP Pet",
        "width": 154,
        "height": 154,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true,
        "url": "/pet.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {}
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://gitee.com/hanliuliu110/csp-pet/raw/master/update.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCQTk4NkFGNzQ5NzJGMTkKUldRWkw1ZDByNGFwVzM0TEl6SDJnSWdBMXdVekJmRDF0d0hDbk5CcXVabUViMjEvTnRGdG9rTjgK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}