{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CSP 学习助手",
  "version": "0.1.0",
  "identifier": "com.csp.desktop-pet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "CSP 学习助手",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "center": true,
        "decorations": true
      },
      {
        "label": "pet",
        "title": "CSP Pet",
        "width": 220,
        "height": 220,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true,
        "url": "/pet.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://gitee.com/hanliuliu110/csp-pet/raw/master/update.json"
      ],
      "pubkey": "Bk1hlRjVhpYJnlC0bwzL3nA1R5jEWIrp68EHlwRceSw=",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
